NODE_ENV=development
PORT=8080

# Use a Mongo Atlas URI in production when available
MONGO_URI=mongodb://localhost:27017/plataforma_servicios

# Optional: set true to run API with in-memory seeded data (demo mode)
USE_IN_MEMORY_DB=false

JWT_SECRET=replace-with-long-random-secret
JWT_ACCESS_EXPIRES=24h

CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
BCRYPT_SALT_ROUNDS=12
